load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//npm:defs.bzl", "npm_package")

npm_package(
    name = "pkg_a",
    srcs = [
        "index.d.ts",
        "index.js",
        "package.json",
    ],
    packable = True,
    publishable = True,
)

npm_package(
    name = "pkg_b",
    srcs = [
        "index.d.ts",
        "index.js",
    ],
    publishable = True,
)

# Regression coverage: a multi-segment `out` must still land the .pack tarball on
# the declared `{name}.tgz` output (pnpm resolves --out relative to --dir).
npm_package(
    name = "pkg_nested",
    srcs = [
        "index.d.ts",
        "index.js",
        "package.json",
    ],
    out = "nested/dist",
    packable = True,
)

sh_test(
    name = "test",
    srcs = ["test.sh"],
    args = [
        "$(rlocationpaths :pkg_a.publish)",
        "$(rlocationpaths :pkg_b.publish)",
    ],
    data = [
        ":pkg_a.publish",
        ":pkg_b.publish",
        "@bazel_tools//tools/bash/runfiles",
    ],
    tags = [
        "no-remote-exec",
        "no-sandbox",
    ],
    # npm_publish.mjs spawns `npm`, which on the PATH is the launcher's npm.bat wrapper. Node
    # refuses to spawn a .bat without a shell, so `npm publish` does not run on Windows at all.
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)

sh_test(
    name = "pack_test",
    srcs = ["pack_test.sh"],
    args = [
        "$(rlocationpath :pkg_a.pack)",
        "$(rlocationpath :pkg_nested.pack)",
    ],
    data = [
        ":pkg_a.pack",
        ":pkg_nested.pack",
        "@bazel_tools//tools/bash/runfiles",
    ],
)
