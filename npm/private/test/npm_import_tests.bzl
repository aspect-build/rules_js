"Unit tests for the package store targets generated by npm_import"

load("@bazel_skylib//lib:unittest.bzl", "asserts", "unittest")
load("//npm/private:npm_import.bzl", "npm_import_testonly")
load("//npm/private:utils.bzl", "utils")

def _target(key, suffix = ""):
    return '":{}/node_modules/{}{}"'.format(utils.package_store_root, utils.package_store_name(key), suffix)

def _attr(key = "a@1.0.0", package = "a", deps = {}, transitive_closure = {}, deps_oss = {}, deps_cpus = {}, lifecycle_build_target = False, in_transitive_closure = False):
    return struct(
        key = key,
        package = package,
        deps = deps,
        transitive_closure = transitive_closure,
        deps_oss = deps_oss,
        deps_cpus = deps_cpus,
        lifecycle_build_target = lifecycle_build_target,
        in_transitive_closure = in_transitive_closure,
    )

def _acyclic_test_impl(ctx):
    env = unittest.begin(ctx)
    result = npm_import_testonly.store_deps(_attr(deps = {"b": "b@1.0.0", "c-alias": "c@2.0.0"}))

    asserts.equals(env, {_target("b@1.0.0"): "b", _target("c@2.0.0"): "c-alias"}, result.deps)
    asserts.equals(env, {_target("b@1.0.0", "/ref"): "b", _target("c@2.0.0", "/ref"): "c-alias"}, result.ref_deps)
    asserts.equals(env, {}, result.lc_deps)
    asserts.equals(env, {}, result.links_deps)
    asserts.equals(env, {}, result.shared_links)
    asserts.false(env, result.has_links)
    asserts.false(env, result.has_transitive_closure)
    return unittest.end(env)

def _closure_member_test_impl(ctx):
    env = unittest.begin(ctx)
    result = npm_import_testonly.store_deps(_attr(deps = {"b": "b@1.0.0"}, in_transitive_closure = True))

    asserts.equals(env, {_target("b@1.0.0"): "b"}, result.deps)
    asserts.equals(env, {_target("b@1.0.0", "/pkg"): "b"}, result.links_deps)
    asserts.equals(env, {}, result.shared_links)
    asserts.true(env, result.has_links)
    asserts.false(env, result.has_transitive_closure)
    return unittest.end(env)

def _cyclic_with_local_member_test_impl(ctx):
    env = unittest.begin(ctx)
    link = utils.importer_to_link("@lib/b", "lib/b")
    result = npm_import_testonly.store_deps(_attr(
        deps = {"b": "b@1.0.0", "@lib/b": link},
        transitive_closure = {
            "a@1.0.0": ["a"],
            "b@1.0.0": ["b"],
            link: ["@lib/b"],
        },
        in_transitive_closure = True,
    ))

    # self /pkg first, then every closure member's /pkg including the workspace package
    asserts.equals(env, {
        _target("a@1.0.0", "/pkg"): "a",
        _target("b@1.0.0", "/pkg"): "b",
        _target(link, "/pkg"): "@lib/b",
    }, result.deps)

    # every closure member shares its /links target; local packages provide an empty one
    asserts.equals(env, {
        _target("a@1.0.0", "/links"): "",
        _target("b@1.0.0", "/links"): "",
        _target(link, "/links"): "",
    }, result.shared_links)

    asserts.equals(env, {_target("b@1.0.0", "/pkg"): "b", _target(link, "/pkg"): "@lib/b"}, result.links_deps)
    asserts.true(env, result.has_links)
    asserts.true(env, result.has_transitive_closure)
    return unittest.end(env)

def _constraints_test_impl(ctx):
    env = unittest.begin(ctx)
    result = npm_import_testonly.store_deps(_attr(
        deps = {"b": "b@1.0.0"},
        transitive_closure = {"a@1.0.0": ["a"], "b@1.0.0": ["b"], "c@1.0.0": ["c"]},
        deps_oss = {"b@1.0.0": ["linux"], "c@1.0.0": ["darwin"]},
        deps_cpus = {"c@1.0.0": ["arm64"]},
        in_transitive_closure = True,
    ))

    # constraints follow every target generated for a constrained dependency
    asserts.equals(env, {
        _target("b@1.0.0", "/ref"): ["linux"],
        _target("b@1.0.0", "/pkg"): ["linux"],
        _target("b@1.0.0", "/links"): ["linux"],
        _target("c@1.0.0", "/pkg"): ["darwin"],
        _target("c@1.0.0", "/links"): ["darwin"],
    }, result.deps_oss)
    asserts.equals(env, {
        _target("c@1.0.0", "/pkg"): ["arm64"],
        _target("c@1.0.0", "/links"): ["arm64"],
    }, result.deps_cpus)
    return unittest.end(env)

def _lifecycle_test_impl(ctx):
    env = unittest.begin(ctx)
    result = npm_import_testonly.store_deps(_attr(
        deps = {"b": "b@1.0.0"},
        transitive_closure = {"a@1.0.0": ["a"], "b@1.0.0": ["b"]},
        lifecycle_build_target = True,
        in_transitive_closure = True,
    ))

    asserts.equals(env, {_target("a@1.0.0", "/pkg"): "a", _target("b@1.0.0", "/pkg"): "b"}, result.deps)
    asserts.equals(env, {_target("a@1.0.0", "/pkg_pre_lc_lite"): "a", _target("b@1.0.0", "/pkg"): "b"}, result.lc_deps)
    asserts.equals(env, {_target("a@1.0.0", "/links"): "", _target("b@1.0.0", "/links"): ""}, result.shared_links)
    asserts.true(env, result.has_lifecycle_build_target)
    return unittest.end(env)

acyclic_test = unittest.make(_acyclic_test_impl)
closure_member_test = unittest.make(_closure_member_test_impl)
cyclic_with_local_member_test = unittest.make(_cyclic_with_local_member_test_impl)
constraints_test = unittest.make(_constraints_test_impl)
lifecycle_test = unittest.make(_lifecycle_test_impl)

def npm_import_tests(name):
    unittest.suite(
        name,
        acyclic_test,
        closure_member_test,
        cyclic_with_local_member_test,
        constraints_test,
        lifecycle_test,
    )
