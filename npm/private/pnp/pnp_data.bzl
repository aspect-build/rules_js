"""Parser and validator for Yarn PnP data files (.pnp.data.json).

The PnP data file is generated by `yarn install` with `pnpEnableInlining: false`
and is the source of truth for Yarn's resolution graph. This module does not
construct a node_modules layout. It validates the generated graph against the
checked-in lockfile and checks the internal root and fallback references. The
small amount of path handling below recognizes Yarn's generated cache and
unplugged locations so Bazel can include and verify those checked-in inputs.
"""

load(":yarn_berry_lock.bzl", "yarn_berry_lock")

_CACHE_LOCATION_INFIX = ".zip/node_modules/"
_UNPLUGGED_INFIX = "/unplugged/"

def _locator(name, reference):
    return "{}@{}".format(name, reference)

def _parse(json_text):
    """Parse a .pnp.data.json file without changing its resolution choices."""
    data = json.decode(json_text)

    errors = []
    packages = []
    top_level = None
    for name_entry in data.get("packageRegistryData", []):
        name = name_entry[0]
        for ref_entry in name_entry[1]:
            reference = ref_entry[0]
            info = ref_entry[1]
            package = struct(
                name = name,
                reference = reference,
                location = info.get("packageLocation", None),
                dependencies = info.get("packageDependencies", []),
                peers = info.get("packagePeers", []),
                link_type = info.get("linkType", None),
            )
            if name == None and reference == None:
                if top_level != None:
                    errors.append("packageRegistryData contains more than one [null, [[null, ...]]] top-level entry")
                else:
                    top_level = package
            elif name == None or reference == None:
                errors.append("packageRegistryData contains a half-null package locator; name and reference must both be null only for the top-level entry")
            else:
                packages.append(package)

    return struct(
        dependency_tree_roots = data.get("dependencyTreeRoots", []),
        enable_top_level_fallback = data.get("enableTopLevelFallback", None),
        errors = errors,
        fallback_exclusion_list = data.get("fallbackExclusionList", []),
        fallback_pool = data.get("fallbackPool", []),
        ignore_pattern_data = data.get("ignorePatternData", None),
        packages = packages,
        pnp_zip_backend = data.get("pnpZipBackend", None),
        top_level = top_level,
    )

def _cache_zip_of(location):
    """Return the cache zip filename encoded by a Yarn packageLocation."""
    if not location:
        return None
    infix = location.find(_CACHE_LOCATION_INFIX)
    if infix == -1:
        return None
    head = location[:infix + len(".zip")]
    slash = head.rfind("/")
    return head[slash + 1:] if slash != -1 else head

def _unplugged_root_of(location):
    """Return the generated unplugged tree root encoded by packageLocation."""
    if not location:
        return None
    marker = location.find(_UNPLUGGED_INFIX)
    if marker == -1:
        return None
    child_start = marker + len(_UNPLUGGED_INFIX)
    child_end = location.find("/", child_start)
    if child_end == -1:
        return None
    root = location[:child_end]
    return root[2:] if root.startswith("./") else root

def _devirtualize(reference):
    """Map a virtual reference to the physical reference it instantiates."""
    if reference.startswith("virtual:"):
        anchor = reference.find("#")
        if anchor == -1:
            return None
        return reference[anchor + 1:]
    return reference

def _dependency(dep):
    """Normalize one packageDependencies tuple while preserving aliases."""
    if type(dep) != "list" or len(dep) != 2:
        return None
    request_name = dep[0]
    value = dep[1]
    if value == None:
        return struct(
            physical_locator = None,
            request_name = request_name,
            target_locator = None,
            target_name = request_name,
            target_reference = None,
        )
    target_name = request_name
    target_reference = value
    if type(value) == "list":
        if len(value) != 2:
            return None
        target_name = value[0]
        target_reference = value[1]
    physical_reference = _devirtualize(target_reference)
    return struct(
        physical_locator = _locator(target_name, physical_reference) if physical_reference != None else None,
        request_name = request_name,
        target_locator = _locator(target_name, target_reference),
        target_name = target_name,
        target_reference = target_reference,
    )

def _dependency_signature(dependencies):
    result = []
    for dep in dependencies:
        normalized = _dependency(dep)
        if normalized == None:
            result.append("<malformed:{}>".format(dep))
        else:
            result.append("{}=>{}".format(normalized.request_name, normalized.target_locator))
    return sorted(result)

def _has_range_syntax(value):
    for marker in [" ", "*", "^", "~", "<", ">", "=", "|"]:
        if marker in value:
            return True
    return False

def _valid_lock_checksum(checksum):
    if type(checksum) != "string":
        return False
    parts = checksum.split("/")
    if len(parts) == 1:
        prefix = None
        digest = parts[0]
    elif len(parts) == 2:
        prefix = parts[0]
        digest = parts[1]
    else:
        return False
    if prefix != None:
        if not prefix:
            return False
        for char in prefix.elems():
            if char not in "0123456789abcdefghijklmnopqrstuvwxyz":
                return False
    if len(digest) != 128:
        return False
    for char in digest.elems():
        if char not in "0123456789abcdef":
            return False
    return True

def _exact_dependency_locator(request_name, target_name, dependency_range):
    """Return the exact locator encoded by a dependency range, when it is exact.

    Yarn v10 lockfiles may omit the original descriptor->resolution key. Exact
    npm and workspace ranges can still be checked without reimplementing Yarn's
    semver/protocol resolution algorithms. Non-exact ranges are checked for a
    stable observed resolution across the complete PnP graph.
    """
    if dependency_range.startswith("npm:"):
        npm_range = dependency_range[len("npm:"):]
        alias_prefix = "{}@".format(target_name)
        if target_name != request_name and npm_range.startswith(alias_prefix):
            npm_range = npm_range[len(alias_prefix):]
        if not _has_range_syntax(npm_range) and "@" not in npm_range:
            return _locator(target_name, "npm:{}".format(npm_range))
    elif dependency_range.startswith("workspace:"):
        workspace_range = dependency_range[len("workspace:"):]
        if not _has_range_syntax(workspace_range):
            return _locator(target_name, dependency_range)
    return None

def _validate_edges(packages, lock, errors):
    """Cross-check lock-declared dependencies against the PnP resolution graph."""
    observed_descriptors = {}
    virtual_physical_locators = {}
    for package in packages.values():
        if package["reference"].startswith("virtual:"):
            virtual_physical_locators[package["physical_locator"]] = True

    for locator in sorted(packages.keys()):
        package = packages[locator]
        entry = lock.entries[package["physical_locator"]]
        expected_dependencies = entry.get("dependencies", {})
        actual_by_name = {}
        for dep in package["normalized_dependencies"]:
            if dep == None:
                errors.append("{}: malformed packageDependencies entry".format(locator))
                continue
            if dep.target_locator == locator or dep.physical_locator == package["physical_locator"] and dep.request_name == package["name"]:
                continue
            if dep.request_name in actual_by_name:
                errors.append("{}: duplicate dependency {} in .pnp.data.json".format(locator, dep.request_name))
                continue
            actual_by_name[dep.request_name] = dep

        # Yarn emits a SOFT physical template for packages with peers. Its
        # concrete virtual HARD instances carry the usable dependency edges.
        physical_peer_template = (
            package["link_type"] == "SOFT" and
            not package["reference"].startswith("workspace:") and
            package["physical_locator"] in virtual_physical_locators
        )
        lock_link_type = entry.get("linkType", None)
        expected_link_type = lock_link_type.upper() if type(lock_link_type) == "string" else None
        if expected_link_type not in ["HARD", "SOFT"]:
            errors.append("{}: yarn.lock has invalid linkType {}".format(locator, lock_link_type))
        elif package["link_type"] != expected_link_type and not (physical_peer_template and package["link_type"] == "SOFT" and expected_link_type == "HARD"):
            errors.append("{}: .pnp.data.json linkType {} does not match yarn.lock linkType {}".format(locator, package["link_type"], expected_link_type))

        for request_name in sorted(expected_dependencies.keys()):
            dependency_range = expected_dependencies[request_name]
            actual = actual_by_name.get(request_name, None)
            if actual == None:
                if not physical_peer_template:
                    errors.append("{}: lock dependency {}@{} is missing from .pnp.data.json".format(locator, request_name, dependency_range))
                continue
            if actual.target_locator == None:
                errors.append("{}: required lock dependency {} is unresolved in .pnp.data.json".format(locator, request_name))
                continue
            if actual.physical_locator not in lock.entries:
                errors.append("{}: dependency {} resolves to {}, which is absent from yarn.lock".format(locator, request_name, actual.physical_locator))
                continue

            descriptor = _locator(request_name, dependency_range)
            expected_resolution = lock.descriptors.get(descriptor, None)
            if expected_resolution != None:
                if actual.physical_locator != expected_resolution:
                    errors.append("{}: dependency {} resolves to {}, expected {} from yarn.lock".format(locator, request_name, actual.physical_locator, expected_resolution))
                continue

            exact_resolution = _exact_dependency_locator(request_name, actual.target_name, dependency_range)
            if exact_resolution != None and actual.physical_locator != exact_resolution:
                errors.append("{}: dependency {} resolves to {}, expected exact {}".format(locator, request_name, actual.physical_locator, exact_resolution))
                continue

            # Yarn v10 may key the lock entry only by its resolved locator. It
            # does not retain enough information to re-run arbitrary protocol
            # and semver resolution without Yarn. Require every occurrence of
            # a descriptor to resolve consistently instead.
            prior = observed_descriptors.get(descriptor, None)
            if prior != None and prior != actual.physical_locator:
                errors.append("{}: descriptor {} resolves inconsistently to {} and {}".format(locator, descriptor, prior, actual.physical_locator))
            else:
                observed_descriptors[descriptor] = actual.physical_locator

        # Additional PnP edges can be produced by packageExtensions and peer
        # injection from .yarnrc.yml. They are part of the integrity-bound PnP
        # graph even though yarn.lock does not serialize those declarations.

def _validate_roots_and_fallback(pnp, packages, lock, errors):
    roots = {}
    for root in pnp.dependency_tree_roots:
        if type(root) != "dict" or root.get("name", None) == None or root.get("reference", None) == None:
            errors.append("dependencyTreeRoots contains a malformed entry")
            continue
        locator = _locator(root["name"], root["reference"])
        if locator in roots:
            errors.append("dependencyTreeRoots contains duplicate {}".format(locator))
            continue
        roots[locator] = True
        package = packages.get(locator, None)
        if package == None:
            errors.append("dependencyTreeRoots references missing package {}".format(locator))
        elif package["link_type"] != "SOFT":
            errors.append("dependency tree root {} must use linkType SOFT".format(locator))

    lock_workspaces = {}
    for locator in lock.entries:
        if "@workspace:" in locator:
            lock_workspaces[locator] = True
    if sorted(roots.keys()) != sorted(lock_workspaces.keys()):
        errors.append("dependencyTreeRoots {} do not match yarn.lock workspaces {}".format(sorted(roots.keys()), sorted(lock_workspaces.keys())))

    exclusions = {}
    for name_entry in pnp.fallback_exclusion_list:
        if type(name_entry) != "list" or len(name_entry) != 2 or type(name_entry[1]) != "list":
            errors.append("fallbackExclusionList contains a malformed entry")
            continue
        for reference in name_entry[1]:
            locator = _locator(name_entry[0], reference)
            if locator in exclusions:
                errors.append("fallbackExclusionList contains duplicate {}".format(locator))
            exclusions[locator] = True
            if locator not in packages:
                errors.append("fallbackExclusionList references missing package {}".format(locator))

    # Yarn serializes the three pnpFallbackMode values using these fields:
    #   none              -> enableTopLevelFallback=false, exclusions=[]
    #   dependencies-only -> enableTopLevelFallback=true, exclusions=roots
    #   all               -> enableTopLevelFallback=true, exclusions=[]
    # There is no explicit mode field in .pnp.data.json, so accept exactly
    # those generated shapes.
    exclusions_list = sorted(exclusions.keys())
    roots_list = sorted(roots.keys())
    if pnp.enable_top_level_fallback == False and exclusions_list:
        errors.append("fallbackExclusionList must be empty when enableTopLevelFallback is false")
    elif pnp.enable_top_level_fallback == True and exclusions_list and exclusions_list != roots_list:
        errors.append("fallbackExclusionList {} must be empty or match dependencyTreeRoots {}".format(exclusions_list, roots_list))

    for dep in pnp.fallback_pool:
        normalized = _dependency(dep)
        if normalized == None:
            errors.append("fallbackPool contains a malformed entry")
        elif normalized.target_locator == None:
            errors.append("fallbackPool entry {} is unresolved".format(normalized.request_name))
        elif normalized.target_locator not in packages:
            errors.append("fallbackPool references missing package {}".format(normalized.target_locator))

    if type(pnp.enable_top_level_fallback) != "bool":
        errors.append("enableTopLevelFallback must be a boolean")
    if pnp.ignore_pattern_data != None and type(pnp.ignore_pattern_data) != "string":
        errors.append("ignorePatternData must be a string or null")
    if pnp.pnp_zip_backend != None and type(pnp.pnp_zip_backend) != "string":
        errors.append("pnpZipBackend must be a string or null")

    if pnp.top_level == None:
        errors.append("packageRegistryData has no [null, [[null, ...]]] top-level entry")
        return

    project_root = None
    for locator in roots:
        package = packages.get(locator, None)
        if package != None and package["location"] == "./":
            if project_root != None:
                errors.append("multiple dependency tree roots use packageLocation ./")
            project_root = package
    if project_root == None:
        errors.append("dependencyTreeRoots has no project root at packageLocation ./")
        return
    if pnp.top_level.link_type != project_root["link_type"] or pnp.top_level.location != project_root["location"] or _dependency_signature(pnp.top_level.dependencies) != project_root["dependency_signature"]:
        errors.append("top-level fallback entry does not match the project root package")

def _validate(pnp, lock_content):
    """Cross-check a generated PnP graph with its checked-in yarn.lock."""
    lock = yarn_berry_lock.parse(lock_content)

    errors = list(pnp.errors)
    packages = {}
    cache_zips = {}
    unplugged_roots = {}

    for pkg in pnp.packages:
        locator = _locator(pkg.name, pkg.reference)
        physical_reference = _devirtualize(pkg.reference)
        if physical_reference == None:
            errors.append("{}: malformed virtual reference".format(locator))
            continue
        physical_locator = _locator(pkg.name, physical_reference)
        entry = lock.entries.get(physical_locator, None)
        if entry == None:
            errors.append("{}: present in .pnp.data.json but not in yarn.lock".format(locator))
            continue
        if locator in packages:
            errors.append("duplicate package locator {} in .pnp.data.json".format(locator))
            continue

        if pkg.link_type not in ["HARD", "SOFT"]:
            errors.append("{}: unrecognized linkType {}".format(locator, pkg.link_type))
        if pkg.reference.startswith("workspace:") and pkg.link_type != "SOFT":
            errors.append("{}: workspace packages must use linkType SOFT".format(locator))
        if not pkg.location:
            errors.append("{}: packageLocation is missing".format(locator))

        zip_name = _cache_zip_of(pkg.location)
        unplugged_root = _unplugged_root_of(pkg.location)
        if zip_name != None:
            cache_zips[zip_name] = True
        if unplugged_root != None:
            unplugged_roots[unplugged_root] = True

        checksum = entry.get("checksum", None)
        if checksum != None and not _valid_lock_checksum(checksum):
            errors.append("{}: yarn.lock checksum must be an optional lowercase cache-key prefix and 128 lowercase hexadecimal characters, got {}".format(locator, checksum))

        normalized_dependencies = [_dependency(dep) for dep in pkg.dependencies]
        packages[locator] = {
            "checksum": checksum,
            "dependencies": [dep.target_locator for dep in normalized_dependencies if dep != None and dep.target_locator != None and dep.target_locator != locator],
            "dependency_signature": _dependency_signature(pkg.dependencies),
            "link_type": pkg.link_type,
            "location": pkg.location,
            "name": pkg.name,
            "normalized_dependencies": normalized_dependencies,
            "physical_locator": physical_locator,
            "reference": pkg.reference,
            "unplugged_root": unplugged_root,
            "zip": zip_name,
        }

    for locator in packages:
        for dep in packages[locator]["normalized_dependencies"]:
            if dep == None:
                continue
            if dep.target_locator != None and dep.target_locator != locator and dep.target_locator not in packages:
                errors.append("{}: dependency {} is not in the package registry".format(locator, dep.target_locator))

    _validate_edges(packages, lock, errors)
    _validate_roots_and_fallback(pnp, packages, lock, errors)

    # Strip internal structs before serializing the validated graph into the
    # generated repository.
    public_packages = {}
    for locator in sorted(packages.keys()):
        package = packages[locator]
        public_packages[locator] = {
            "checksum": package["checksum"],
            "dependencies": package["dependencies"],
            "link_type": package["link_type"],
            "location": package["location"],
            "physical_locator": package["physical_locator"],
            "unplugged_root": package["unplugged_root"],
            "zip": package["zip"],
        }

    return struct(
        cache_zips = sorted(cache_zips.keys()),
        errors = errors,
        packages = public_packages,
        unplugged_roots = sorted(unplugged_roots.keys()),
    )

pnp_data = struct(
    devirtualize = _devirtualize,
    parse = _parse,
    validate = _validate,
)
