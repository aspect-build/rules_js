"""Parser and validator for Yarn PnP data files (.pnp.data.json).

The PnP data file is generated by `yarn install` with `pnpEnableInlining: false`
and fully describes the resolution graph: every package locator, where its
content lives (a zip in the offline cache, or a workspace directory), and its
dependency edges. rules_js consumes it as-is and never derives or decides any
layout itself; validation below only cross-checks the file against yarn.lock so
that everything the runtime will load is covered by a checksum.
"""

load(":yarn_berry_lock.bzl", "yarn_berry_lock")

_CACHE_LOCATION_INFIX = ".zip/node_modules/"

def _parse(json_text):
    """Parse a .pnp.data.json file.

    Args:
        json_text: string content of the .pnp.data.json file

    Returns:
        struct with fields:
            dependency_tree_roots: list of {name, reference} dicts
            packages: list of structs, one per (name, reference) pair in
                packageRegistryData, with fields name, reference, location,
                dependencies (list of [name, reference-or-alias]), link_type
    """
    data = json.decode(json_text)

    packages = []
    for name_entry in data.get("packageRegistryData", []):
        name = name_entry[0]
        for ref_entry in name_entry[1]:
            reference = ref_entry[0]
            info = ref_entry[1]
            packages.append(struct(
                name = name,
                reference = reference,
                location = info.get("packageLocation", None),
                dependencies = info.get("packageDependencies", []),
                link_type = info.get("linkType", None),
            ))

    return struct(
        dependency_tree_roots = data.get("dependencyTreeRoots", []),
        packages = packages,
    )

def _cache_zip_of(location):
    """Return the cache zip filename a packageLocation points into, or None.

    Handles both plain cache locations (./.yarn/cache/<zip>/node_modules/...)
    and virtual locations (./.yarn/__virtual__/<hash>/<depth>/cache/<zip>/...),
    which Berry uses to give peer-dependency instances distinct paths into the
    same physical archive.
    """
    if not location or not location.startswith("./.yarn/"):
        return None
    infix = location.find(_CACHE_LOCATION_INFIX)
    if infix == -1:
        return None
    head = location[:infix + len(".zip")]
    cache = head.rfind("cache/")
    if cache == -1:
        return None
    return head[cache + len("cache/"):]

def _devirtualize(reference):
    """Map a virtual reference to the physical reference it instantiates."""
    if reference.startswith("virtual:"):
        anchor = reference.find("#")
        if anchor == -1:
            return None
        return reference[anchor + 1:]
    return reference

def _validate(pnp, lock_content):
    """Cross-check PnP data against yarn.lock.

    Every hard-linked package must resolve to a zip in the offline cache and
    have a checksum in yarn.lock; every soft link must be a workspace. Content
    hashes are verified at build time by pnp_verify_test - this function only
    establishes that the checked-in inputs are complete and mutually consistent.

    Args:
        pnp: return value of parse()
        lock_content: string content of yarn.lock

    Returns:
        struct with fields:
            packages: dict keyed by locator (`name@reference`) with value dicts
                {"zip": cache zip filename or None, "checksum": str or None,
                 "dependencies": list of locator strings}
            cache_zips: sorted list of cache zip filenames referenced by the graph
            errors: list of human-readable validation errors; empty when valid
    """
    lock = yarn_berry_lock.parse(lock_content)

    errors = []
    packages = {}
    cache_zips = {}

    for pkg in pnp.packages:
        if pkg.name == None or pkg.reference == None:
            # The [null, ...] entry is the PnP top-level fallback; it carries
            # no content of its own.
            continue

        locator = "{}@{}".format(pkg.name, pkg.reference)
        physical_reference = _devirtualize(pkg.reference)
        if physical_reference == None:
            errors.append("{}: malformed virtual reference".format(locator))
            continue
        entry = lock.entries.get("{}@{}".format(pkg.name, physical_reference), None)
        if entry == None:
            errors.append("{}: present in .pnp.data.json but not in yarn.lock".format(locator))
            continue

        zip_name = None
        checksum = None
        if pkg.link_type == "SOFT":
            if not pkg.reference.startswith("workspace:"):
                errors.append("{}: SOFT link with non-workspace reference".format(locator))
                continue
        elif pkg.link_type == "HARD":
            zip_name = _cache_zip_of(pkg.location)
            if zip_name == None:
                errors.append("{}: packageLocation {} does not point into the checked-in offline cache under .yarn/".format(locator, pkg.location))
                continue
            checksum = entry.get("checksum", None)
            if checksum == None:
                errors.append("{}: no checksum in yarn.lock".format(locator))
                continue
            if checksum.count("/") != 1:
                errors.append("{}: unrecognized checksum format {}".format(locator, checksum))
                continue
            cache_zips[zip_name] = True
        else:
            errors.append("{}: unrecognized linkType {}".format(locator, pkg.link_type))
            continue

        dependencies = []
        for dep in pkg.dependencies:
            dep_name = dep[0]
            dep_ref = dep[1]
            if dep_ref == None:
                # Unfulfilled peer dependency; nothing to record.
                continue
            if type(dep_ref) == "list":
                # Alias: [name, reference] of the aliased package.
                dep_name = dep_ref[0]
                dep_ref = dep_ref[1]
            dep_locator = "{}@{}".format(dep_name, dep_ref)
            if dep_locator != locator:
                dependencies.append(dep_locator)

        packages[locator] = {
            "checksum": checksum,
            "dependencies": dependencies,
            "zip": zip_name,
        }

    for locator in packages:
        for dep_locator in packages[locator]["dependencies"]:
            if dep_locator not in packages:
                errors.append("{}: dependency {} is not in the package registry".format(locator, dep_locator))

    return struct(
        packages = packages,
        cache_zips = sorted(cache_zips.keys()),
        errors = errors,
    )

pnp_data = struct(
    parse = _parse,
    validate = _validate,
)
