load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("//js:defs.bzl", "js_binary", "js_library", "js_test")

exports_files(
    [
        "pnp_integrity.mjs",
        "pnp_verify.mjs",
        "pnp_verify_test.mjs",
    ],
    visibility = ["//visibility:public"],
)

# Wraps the verifier so it can be the entry_point of js_test targets in other
# packages and repositories (see pnp_verify_test in the generated defs.bzl).
js_library(
    name = "pnp_verify",
    srcs = ["pnp_verify.mjs"],
    visibility = ["//visibility:public"],
)

js_binary(
    name = "pnp_integrity",
    data = [":pnp_verify"],
    entry_point = "pnp_integrity.mjs",
    visibility = ["//visibility:public"],
)

js_test(
    name = "pnp_verify_test",
    data = [":pnp_verify"],
    entry_point = "pnp_verify_test.mjs",
)

bzl_library(
    name = "yarn_berry_lock",
    srcs = ["yarn_berry_lock.bzl"],
    visibility = ["//npm:__subpackages__"],
)

bzl_library(
    name = "pnp_data",
    srcs = ["pnp_data.bzl"],
    visibility = ["//npm:__subpackages__"],
    deps = [":yarn_berry_lock"],
)

bzl_library(
    name = "pnp_integrity_bzl",
    srcs = ["pnp_integrity.bzl"],
    visibility = ["//npm:__subpackages__"],
)

bzl_library(
    name = "pnp_repository",
    srcs = ["pnp_repository.bzl"],
    visibility = ["//npm:__subpackages__"],
    deps = [
        ":pnp_data",
        ":pnp_integrity_bzl",
    ],
)

bzl_library(
    name = "pnp_extension",
    srcs = ["pnp_extension.bzl"],
    visibility = ["//npm:__subpackages__"],
    deps = [":pnp_repository"],
)
