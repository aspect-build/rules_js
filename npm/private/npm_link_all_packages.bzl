"""Implementation of the npm_link_all_packages() and npm_link_targets() macros generated by npm_translate_lock."""

load("//js:defs.bzl", "js_library")

def npm_link_all_packages_internal(name, imported_links, prod, dev, link_targets, is_importer):
    """Create the node_modules and node_modules/@scope js_library targets for a package.

    Args:
        name: must be "node_modules"
        imported_links: link functions from manually imported packages
        prod: whether production dependencies are included
        dev: whether development dependencies are included
        link_targets: labels of the packages already linked into this package
        is_importer: whether this package is a pnpm workspace project
    """
    if name != "node_modules":
        fail("npm_link_all_packages: customizing 'name' is not supported")
    if not prod and not dev:
        fail("npm_link_all_packages: at least one of 'prod' or 'dev' must be True")

    link_targets = list(link_targets)
    scope_targets = {}
    for target in link_targets:
        alias = target[len(":node_modules/"):]
        if alias.startswith("@"):
            scope_targets.setdefault(alias[:alias.find("/", 1)], []).append(target)

    for link_fn in imported_links:
        new_link_targets, new_scope_targets = link_fn(name, prod, dev)
        link_targets.extend(new_link_targets)
        for scope, targets in new_scope_targets.items():
            scope_targets.setdefault(scope, []).extend(targets)

    for scope, scoped_targets in scope_targets.items():
        js_library(
            name = "node_modules/{}".format(scope),
            srcs = scoped_targets,
            tags = ["manual"],
            visibility = ["//visibility:public"],
        )

    if is_importer:
        js_library(
            name = "node_modules",
            srcs = link_targets,
            tags = ["manual"],
            visibility = ["//visibility:public"],
        )

def npm_link_targets_internal(name, package, prod, dev, link_targets):
    """List the labels of the packages npm_link_all_packages() links into a package.

    Args:
        name: must be "node_modules"
        package: the bazel package the targets are linked in
        prod: include production dependencies
        dev: include development dependencies
        link_targets: dict with the "prod" and "dev" target names linked in the package

    Returns:
        A list of labels
    """
    if name != "node_modules":
        fail("npm_link_targets: customizing 'name' is not supported")
    if not prod and not dev:
        fail("npm_link_targets: at least one of 'prod' or 'dev' must be True")

    targets = []
    if prod:
        targets.extend(link_targets.get("prod", []))
    if dev:
        targets.extend(link_targets.get("dev", []))
    return ["//%s%s" % (package, target) for target in targets]
