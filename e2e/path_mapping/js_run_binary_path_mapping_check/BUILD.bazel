load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@rules_js//js:defs.bzl", "js_binary", "js_run_binary")

# Verifies that a js_run_binary target supports path mapping. This requires
# set_legacy_environment_variables to be disabled (the default), and args must
# avoid Make variable and location expansion.
#
# stdout/stderr/exit_code_out are captured here to verify that they do not
# defeat path mapping.
js_binary(
    name = "check",
    entry_point = "check.mjs",
)

js_run_binary(
    name = "js_run_binary_path_mapping_check",
    outs = ["out.txt"],
    args = ["out.txt"],
    chdir = package_name(),
    exit_code_out = "exit_code.txt",
    mnemonic = "JsRunBinaryPathMappingCheck",
    silent_on_success = False,
    stderr = "stderr.txt",
    stdout = "stdout.txt",
    tool = ":check",
)

# Verifies the captured stdout/stderr/exit_code files actually landed where the
# launcher was told to write them, and with the expected content.
diff_test(
    name = "stdout_test",
    file1 = ":stdout.txt",
    file2 = "expected_stdout.txt",
)

diff_test(
    name = "stderr_test",
    file1 = ":stderr.txt",
    file2 = "expected_stderr.txt",
)

diff_test(
    name = "exit_code_test",
    file1 = ":exit_code.txt",
    file2 = "expected_exit_code.txt",
)

build_test(
    name = "js_run_binary_path_mapping_check_test",
    targets = [":js_run_binary_path_mapping_check"],
)
