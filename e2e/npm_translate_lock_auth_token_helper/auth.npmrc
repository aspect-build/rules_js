# @aspect-build private GitHub registry, authenticated with a tokenHelper instead of a
# static token. test.sh rewrites the placeholder below to token-helper.sh's absolute path.
@aspect-build:registry=https://npm.pkg.github.com/
//npm.pkg.github.com/:tokenHelper=__TOKEN_HELPER__

# npm auth token for the @aspect-priv-npm scope on the default registry
_authToken=${ASPECT_NPM_AUTH_TOKEN}
