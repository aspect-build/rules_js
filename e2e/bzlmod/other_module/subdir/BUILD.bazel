load("@npm_other_module//:less/package_json.bzl", less_bin = "bin")

# Verifies that js_run_binary() works in a subdirectory of an external module with chdir.
# exit_code_out additionally covers resolving a capture output path, which is
# passed to the launcher relative to the bin directory, from an external repo.
less_bin.lessc(
    name = "styles",
    srcs = ["my.less"],
    outs = ["my.css"],
    args = [
        "my.less",
        "my.css",
    ],
    chdir = package_name(),
    exit_code_out = "exit_code.txt",
    silent_on_success = False,
    visibility = ["//visibility:public"],
)
