bazel_dep(name = "rules_js", version = "0.0.0", dev_dependency = True)
local_path_override(
    module_name = "rules_js",
    path = "../..",
)

npm = use_extension(
    "@rules_js//npm:extensions.bzl",
    "npm",
    dev_dependency = True,
)
npm.npm_translate_lock(
    name = "npm",
    data = [
        "//subdir:package.json",
        "//subdir:patches/aspect-test-e-pnpm.patch",
        "//subdir:patches/debug@4.3.4.patch",
    ],
    npmrc = "//:.npmrc",
    patch_args = {
        "*": ["-p0"],
        "@aspect-test/e": ["ignored"],
        "@aspect-test/e@1.0.0": [
            "apply",
            "-p1",
        ],
    },
    patch_tools = {
        "@aspect-test/e": "//subdir:patch-tool.sh",
        "@aspect-test/e@1.0.0": "//subdir:patch-tool.sh",
    },
    pnpm_lock = "//subdir:pnpm-lock.yaml",
    verify_node_modules_ignored = "//:.bazelignore",
)
use_repo(npm, "npm")
