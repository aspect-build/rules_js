bazel_dep(name = "rules_js", version = "0.0.0", dev_dependency = True)
local_path_override(
    module_name = "rules_js",
    path = "../..",
)

bazel_dep(name = "bazel_lib", version = "3.0.0", dev_dependency = True)

npm = use_extension(
    "@rules_js//npm:extensions.bzl",
    "npm",
    dev_dependency = True,
)
npm.npm_translate_lock(
    name = "npm",
    data = ["//:package.json"],
    lifecycle_hooks_use_default_shell_env = {
        "segfault-handler": "true",
    },
    npmrc = "//:.npmrc",
    pnpm_lock = "//:pnpm-lock.yaml",
    update_pnpm_lock = True,
    verify_node_modules_ignored = "//:.bazelignore",
)
use_repo(
    npm,
    "npm",
    "npm__segfault-handler__1.3.0__links",
)
