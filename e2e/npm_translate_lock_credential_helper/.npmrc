# Disabling pnpm [hoisting](https://pnpm.io/npmrc#hoist) by setting `hoist=false` is recommended on
# projects using rules_js so that pnpm outside of Bazel lays out a node_modules tree similar to what
# rules_js lays out under Bazel (without a hidden node_modules/.pnpm/node_modules)
hoist=false

# @aspect-build private GitHub registry. No auth settings here: credentials for it and for the
# private @aspect-priv-npm scope on registry.npmjs.org come from credential-helper.sh.
@aspect-build:registry=https://npm.pkg.github.com/
