import %workspace%/../../tools/preset.bazelrc
import %workspace%/../e2e.bazelrc

# One scope per registry the lockfile resolves against: the default, plus the
# @aspect-build registry in pnpm-workspace.yaml. Add a line when adding one.
# Unscoped, the helper applies to every URI -- including Aspect's cache and BES,
# which it has no token for, so the CLI suppresses its own auth header.
common --credential_helper=registry.npmjs.org=%workspace%/credential-helper.sh
common --credential_helper=npm.pkg.github.com=%workspace%/credential-helper.sh
