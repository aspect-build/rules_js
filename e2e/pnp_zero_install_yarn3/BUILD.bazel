load("@pnp//:defs.bzl", "pnp_verify_test")

filegroup(
    name = "pnp_cache",
    srcs = glob([".yarn/cache/*.zip"]),
    visibility = ["//visibility:public"],
)

# Yarn 3.x lockfiles and PnP data files are fully supported on the import and
# verification side: loading @pnp validates .pnp.data.json against yarn.lock,
# and this test verifies all checked-in artifacts and recomputes the sha512 of
# every cache archive.
#
# Runtime execution (pnp_js_binary / pnp_js_test) is only supported with
# artifacts generated by Yarn 4+: the Yarn 3 .pnp.cjs runtime loads a second
# instance of itself when the project is reachable through more than one path
# spelling - as it is under Bazel's runfiles and output trees - and the two
# instances recurse into each other until the stack overflows. Yarn 4's
# runtime tolerates the same layout (see ../pnp_zero_install).
pnp_verify_test(
    name = "verify_cache_test",
)
