bazel_dep(name = "rules_js", version = "0.0.0", dev_dependency = True)
local_path_override(
    module_name = "rules_js",
    path = "../..",
)

pnpm = use_extension("@rules_js//npm:extensions.bzl", "pnpm")
pnpm.pnpm(
    name = "pnpm",
    pnpm_version = "9.15.9",
)
use_repo(pnpm, "pnpm", "pnpm__links")

npm = use_extension(
    "@rules_js//npm:extensions.bzl",
    "npm",
    dev_dependency = True,
)
npm.npm_translate_lock(
    name = "npm",
    data = [
        "//:package.json",
        "//:pnpm-workspace.yaml",
        "//lib:package.json",
        "//lib-dupes:package.json",
        "//tests:package.json",
    ],
    npmrc = "//:.npmrc",
    pnpm_lock = "//:pnpm-lock.yaml",
    update_pnpm_lock = True,
    verify_node_modules_ignored = "//:.bazelignore",
)
use_repo(npm, "npm")
