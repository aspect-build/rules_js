load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load(":index.bzl", "PNPM_ARCHS", "PNPM_LIBCS", "PNPM_PLATFORMS")

# Constraints representing the pnpm [os], [cpu] and [libc] fields.
bzl_library(
    name = "index_bzl",
    srcs = ["index.bzl"],
    visibility = ["//npm:__subpackages__"],
)

# Support pnpm platforms
[
    alias(
        name = p,
        actual = target,
        visibility = ["//visibility:public"],
    )
    for p, target in PNPM_PLATFORMS.items()
    if target
]

# Support pnpm architectures
[
    alias(
        name = a,
        actual = target,
        visibility = ["//visibility:public"],
    )
    for a, target in PNPM_ARCHS.items()
    if target
]

# Support pnpm libc implementations
[
    alias(
        name = libc,
        actual = target,
        visibility = ["//visibility:public"],
    )
    for libc, target in PNPM_LIBCS.items()
]

# Supported pnpm platform * libc pairs
[
    [
        config_setting(
            name = "{}_{}".format(p, libc),
            constraint_values = [
                ptarget,
                ltarget,
            ],
            visibility = ["//visibility:public"],
        )
        for libc, ltarget in PNPM_LIBCS.items()
    ]
    for p, ptarget in PNPM_PLATFORMS.items()
    if ptarget
]

# Supported pnpm architecture * libc pairs
[
    [
        config_setting(
            name = "{}_{}".format(a, libc),
            constraint_values = [
                atarget,
                ltarget,
            ],
            visibility = ["//visibility:public"],
        )
        for libc, ltarget in PNPM_LIBCS.items()
    ]
    for a, atarget in PNPM_ARCHS.items()
    if atarget
]

# Supported pnpm platform * architecture pairs
[
    [
        config_setting(
            name = "{}_{}".format(p, a),
            constraint_values = [
                ptarget,
                atarget,
            ],
            visibility = ["//visibility:public"],
        )
        for a, atarget in PNPM_ARCHS.items()
        if atarget
    ]
    for p, ptarget in PNPM_PLATFORMS.items()
    if ptarget
]

# Supported pnpm platform * architecture * libc triples
[
    [
        [
            config_setting(
                name = "{}_{}_{}".format(p, a, libc),
                constraint_values = [
                    ptarget,
                    atarget,
                    ltarget,
                ],
                visibility = ["//visibility:public"],
            )
            for libc, ltarget in PNPM_LIBCS.items()
        ]
        for a, atarget in PNPM_ARCHS.items()
        if atarget
    ]
    for p, ptarget in PNPM_PLATFORMS.items()
    if ptarget
]
