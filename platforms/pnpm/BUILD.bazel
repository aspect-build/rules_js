load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load(":index.bzl", "PNPM_ARCHS", "PNPM_LIBCS", "PNPM_PLATFORMS")

# Constraints representing the pnpm [os] and [cpu] fields.
bzl_library(
    name = "index_bzl",
    srcs = ["index.bzl"],
    visibility = ["//npm:__subpackages__"],
)

# Support pnpm platforms
[
    alias(
        name = p,
        actual = target,
        visibility = ["//visibility:public"],
    )
    for p, target in PNPM_PLATFORMS.items()
    if target
]

# Support pnpm architectures
[
    alias(
        name = a,
        actual = target,
        visibility = ["//visibility:public"],
    )
    for a, target in PNPM_ARCHS.items()
    if target
]

# Supported pnpm platform * architecture pairs
[
    [
        config_setting(
            name = "{}_{}".format(p, a),
            constraint_values = [
                ptarget,
                atarget,
            ],
            visibility = ["//visibility:public"],
        )
        for a, atarget in PNPM_ARCHS.items()
        if atarget
    ]
    for p, ptarget in PNPM_PLATFORMS.items()
    if ptarget
]

# Supported linux * architecture * libc triples, including an unconstrained libc
# so that a platform which does not set //platforms/libc matches all of them.
[
    [
        config_setting(
            name = "linux_{}_{}".format(a, libc),
            constraint_values = [
                PNPM_PLATFORMS["linux"],
                atarget,
                ltarget,
            ],
            visibility = ["//visibility:public"],
        )
        for libc, ltarget in PNPM_LIBCS.items() + [("unconstrained", "@aspect_rules_js//platforms/libc:unconstrained")]
    ]
    for a, atarget in PNPM_ARCHS.items()
    if atarget
]
