load("@bazel_lib//lib:testing.bzl", "assert_contains")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("//js:defs.bzl", "js_binary")
load(":launcher_sync.bzl", "launcher_sync_test")

# Here we run the same js_binary under both the bash and JS launchers in one build, and diff
# the state node ends up in. This helps us ensure that the two launchers remain aligned.

package(default_testonly = True)

# Two files so that a single $(rootpaths) fixed_arg expands to more than one path.
write_file(
    name = "write_arg_file_a",
    out = "arg_file_a.txt",
    content = [],
)

write_file(
    name = "write_arg_file_b",
    out = "arg_file_b.txt",
    content = [],
)

filegroup(
    name = "arg_files",
    srcs = [
        "arg_file_a.txt",
        "arg_file_b.txt",
    ],
)

js_binary(
    name = "state_bin",
    data = [":arg_files"],
    entry_point = "dump_state.mjs",
    fixed_args = [
        # Quote removal and word splitting: one argument despite the space, then two.
        "\"one argument\"",
        "two arguments",
        # $VAR is expanded unless it is single-quoted.
        "$$JS_BINARY__WORKSPACE",
        "'$$JS_BINARY__WORKSPACE'",
        # One fixed_arg that expands to several paths, which splitting turns into several arguments.
        "$(rootpaths :arg_files)",
    ],
)

launcher_sync_test(
    name = "state_test",
    tool = ":state_bin",
)

# A diff_test passes just as happily when both files are empty, so pin one line that has to
# be there.
assert_contains(
    name = "state_dump_not_empty_test",
    actual = ":state_test_bash",
    expected = "env[JS_BINARY__RUNFILES]=",
)
