load("@bazel_lib//lib:diff_test.bzl", "diff_test")
load("@bazel_lib//lib:testing.bzl", "assert_contains")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("//js:defs.bzl", "js_binary", "js_run_binary", "js_test")
load("//js/private/test:launcher_flags.bzl", "BASH_LAUNCHER_ONLY", "HERMETIC_LAUNCHER_ONLY")
load(":direct_capture.bzl", "direct_capture")

package(default_testonly = True)

# POSIX directed per-PID signal delivery; SIGTERM/SIGINT semantics differ on Windows.
_POSIX_ONLY = select({
    "@platforms//os:windows": ["@platforms//:incompatible"],
    "//conditions:default": [],
})

# ==================================================================================================
# Case 1: a directed termination signal reaches node's own handler.
#
# signal_driver spawns signal_target and sends the signal to the launcher PID. On the exec path the
# launcher has replaced itself with node, so the signal is delivered straight to node and its handler
# runs and prints HANDLED. SIGTERM and SIGINT are both exercised.

js_binary(
    name = "signal_target_sigterm",
    entry_point = "signal_target.mjs",
    fixed_args = ["SIGTERM"],
)

js_test(
    name = "signal_forwarding_sigterm_test",
    size = "small",
    data = [
        ":signal_target_sigterm",
        "//:node_modules/@bazel/runfiles",
    ],
    entry_point = "signal_driver.mjs",
    fixed_args = [
        "$(rlocationpath :signal_target_sigterm)",
        "SIGTERM",
    ],
    target_compatible_with = _POSIX_ONLY,
)

js_binary(
    name = "signal_target_sigint",
    entry_point = "signal_target.mjs",
    fixed_args = ["SIGINT"],
)

js_test(
    name = "signal_forwarding_sigint_test",
    size = "small",
    data = [
        ":signal_target_sigint",
        "//:node_modules/@bazel/runfiles",
    ],
    entry_point = "signal_driver.mjs",
    fixed_args = [
        "$(rlocationpath :signal_target_sigint)",
        "SIGINT",
    ],
    target_compatible_with = _POSIX_ONLY,
)

# ==================================================================================================
# Case 1b: a directed termination signal reaches node's own handler on the expected_exit_code path.
#
# With expected_exit_code set the launcher cannot exec (it must observe node's exit code to remap
# it), so it must forward a directed signal to node itself. node's handler must still run and print
# HANDLED. SIGTERM and SIGINT are both exercised.

js_binary(
    name = "signal_target_remap_sigterm",
    entry_point = "signal_target.mjs",
    expected_exit_code = 42,
    fixed_args = ["SIGTERM"],
)

js_test(
    name = "signal_forwarding_remap_sigterm_test",
    size = "small",
    data = [
        ":signal_target_remap_sigterm",
        "//:node_modules/@bazel/runfiles",
    ],
    entry_point = "signal_driver.mjs",
    fixed_args = [
        "$(rlocationpath :signal_target_remap_sigterm)",
        "SIGTERM",
    ],
    target_compatible_with = _POSIX_ONLY,
)

js_binary(
    name = "signal_target_remap_sigint",
    entry_point = "signal_target.mjs",
    expected_exit_code = 42,
    fixed_args = ["SIGINT"],
)

js_test(
    name = "signal_forwarding_remap_sigint_test",
    size = "small",
    data = [
        ":signal_target_remap_sigint",
        "//:node_modules/@bazel/runfiles",
    ],
    entry_point = "signal_driver.mjs",
    fixed_args = [
        "$(rlocationpath :signal_target_remap_sigint)",
        "SIGINT",
    ],
    target_compatible_with = _POSIX_ONLY,
)

# ==================================================================================================
# Case 2: node killed by an unhandled signal is terminated by that signal.
#
# stay_alive installs no signal handlers. On the exec path the launcher has replaced itself with
# node, so the signal kills node directly and the process is reported as signal-terminated
# (code=null, signal=<name>) rather than exiting with a 128+N code.

js_binary(
    name = "stay_alive_bin",
    entry_point = "stay_alive.mjs",
)

js_test(
    name = "signal_exit_code_sigterm_test",
    size = "small",
    data = [
        ":stay_alive_bin",
        "//:node_modules/@bazel/runfiles",
    ],
    entry_point = "signal_exit_driver.mjs",
    fixed_args = [
        "$(rlocationpath :stay_alive_bin)",
        "SIGTERM",
    ],
    target_compatible_with = _POSIX_ONLY,
)

js_test(
    name = "signal_exit_code_sigint_test",
    size = "small",
    data = [
        ":stay_alive_bin",
        "//:node_modules/@bazel/runfiles",
    ],
    entry_point = "signal_exit_driver.mjs",
    fixed_args = [
        "$(rlocationpath :stay_alive_bin)",
        "SIGINT",
    ],
    target_compatible_with = _POSIX_ONLY,
)

# ==================================================================================================
# Case 3: expected_exit_code remapping in the launcher.
#
# When node exits 0 but a non-zero code was expected, the launcher must report Bazel's "tests
# failed" sentinel (exit 3). When node exits a different non-zero code, that code is propagated.
# When node exits exactly the expected code, the launcher reports success (exit 0).

js_binary(
    name = "exit_zero_bin",
    entry_point = "exit_with.mjs",
    expected_exit_code = 42,
    fixed_args = ["0"],
)

js_run_binary(
    name = "exit_zero_run",
    chdir = package_name(),
    exit_code_out = "exit_zero_code.txt",
    stderr = "exit_zero_stderr.txt",
    stdout = "exit_zero_stdout.txt",
    tool = ":exit_zero_bin",
)

write_file(
    name = "exit_zero_expected",
    out = "exit_zero_expected.txt",
    content = ["3"],
)

diff_test(
    name = "remap_unexpected_success_test",
    file1 = ":exit_zero_expected.txt",
    file2 = ":exit_zero_code.txt",
)

js_binary(
    name = "exit_seven_bin",
    entry_point = "exit_with.mjs",
    expected_exit_code = 42,
    fixed_args = ["7"],
)

js_run_binary(
    name = "exit_seven_run",
    chdir = package_name(),
    exit_code_out = "exit_seven_code.txt",
    stderr = "exit_seven_stderr.txt",
    stdout = "exit_seven_stdout.txt",
    tool = ":exit_seven_bin",
)

write_file(
    name = "exit_seven_expected",
    out = "exit_seven_expected.txt",
    content = ["7"],
)

diff_test(
    name = "remap_mismatch_test",
    file1 = ":exit_seven_expected.txt",
    file2 = ":exit_seven_code.txt",
)

js_binary(
    name = "exit_expected_bin",
    entry_point = "exit_with.mjs",
    expected_exit_code = 42,
    fixed_args = ["42"],
)

js_run_binary(
    name = "exit_expected_run",
    chdir = package_name(),
    exit_code_out = "exit_expected_code.txt",
    stderr = "exit_expected_stderr.txt",
    stdout = "exit_expected_stdout.txt",
    tool = ":exit_expected_bin",
)

write_file(
    name = "exit_expected_expected",
    out = "exit_expected_expected.txt",
    content = ["0"],
)

diff_test(
    name = "remap_expected_match_test",
    file1 = ":exit_expected_expected.txt",
    file2 = ":exit_expected_code.txt",
)

# ==================================================================================================
# Case 4: with no expected_exit_code the launcher propagates node's exit code verbatim.

js_binary(
    name = "exit_plain_bin",
    entry_point = "exit_with.mjs",
    fixed_args = ["7"],
)

js_run_binary(
    name = "exit_plain_run",
    chdir = package_name(),
    exit_code_out = "exit_plain_code.txt",
    silent_on_success = False,
    stderr = "exit_plain_stderr.txt",
    stdout = "exit_plain_stdout.txt",
    tool = ":exit_plain_bin",
)

write_file(
    name = "exit_plain_expected",
    out = "exit_plain_expected.txt",
    content = ["7"],
)

diff_test(
    name = "propagate_exit_code_test",
    file1 = ":exit_plain_expected.txt",
    file2 = ":exit_plain_code.txt",
)

# ==================================================================================================
# Case 5: the launcher passes stdin through to node.

js_binary(
    name = "stdin_cat_bin",
    entry_point = "stdin_cat.mjs",
)

genrule(
    name = "stdin_run",
    outs = ["stdin_out.txt"],
    cmd = "printf 'hello stdin' | BAZEL_BINDIR=$(BINDIR) $(execpath :stdin_cat_bin) > $@",
    tools = [":stdin_cat_bin"],
)

assert_contains(
    name = "stdin_passthrough_test",
    actual = ":stdin_out.txt",
    expected = "hello stdin",
)

# ==================================================================================================
# Case 6: the launcher passes node's stdout and stderr through on separate streams.

js_binary(
    name = "stdout_stderr_bin",
    entry_point = "stdout_stderr.mjs",
)

js_run_binary(
    name = "stdout_stderr_run",
    chdir = package_name(),
    silent_on_success = False,
    stderr = "stdout_stderr_stderr.txt",
    stdout = "stdout_stderr_stdout.txt",
    tool = ":stdout_stderr_bin",
)

assert_contains(
    name = "stdout_passthrough_test",
    actual = ":stdout_stderr_stdout.txt",
    expected = "ON_STDOUT",
)

assert_contains(
    name = "stderr_passthrough_test",
    actual = ":stdout_stderr_stderr.txt",
    expected = "ON_STDERR",
)

# ==================================================================================================
# Case 7: the launcher honors its own capture environment variables when invoked directly.
#
# js_run_binary delegates stdout/stderr/exit_code_out/silent_on_success to bazel-lib's run_binary,
# so it no longer sets JS_BINARY__STDOUT_OUTPUT_FILE and friends. Code outside rules_js does invoke
# the launcher directly and set them, so the launcher still implements them and these cases keep
# that path covered.

# A tool that writes to both streams and exits 0: the captures must land in the declared files.
direct_capture(
    name = "direct_capture_streams",
    target_compatible_with = BASH_LAUNCHER_ONLY,
    tool = ":stdout_stderr_bin",
)

assert_contains(
    name = "direct_capture_stdout_test",
    actual = ":direct_capture_streams_stdout.txt",
    expected = "ON_STDOUT",
)

assert_contains(
    name = "direct_capture_stderr_test",
    actual = ":direct_capture_streams_stderr.txt",
    expected = "ON_STDERR",
)

write_file(
    name = "direct_capture_streams_expected_code",
    out = "direct_capture_streams_expected_code.txt",
    content = ["0"],
)

diff_test(
    name = "direct_capture_zero_exit_code_test",
    file1 = ":direct_capture_streams_expected_code.txt",
    file2 = ":direct_capture_streams_exit_code.txt",
)

# A tool that exits non-zero: the launcher must record the code and itself exit 0, so the action
# still succeeds and all three declared outputs appear.
direct_capture(
    name = "direct_capture_exit",
    target_compatible_with = BASH_LAUNCHER_ONLY,
    tool = ":exit_plain_bin",
)

write_file(
    name = "direct_capture_exit_expected_code",
    out = "direct_capture_exit_expected_code.txt",
    content = ["7"],
)

diff_test(
    name = "direct_capture_exit_code_test",
    file1 = ":direct_capture_exit_expected_code.txt",
    file2 = ":direct_capture_exit_exit_code.txt",
)

# JS_BINARY__SILENT_ON_SUCCESS with no capture file for either stream should result in nothing
# written to stdout or stderr.
genrule(
    name = "direct_silent_run",
    outs = ["direct_silent_out.txt"],
    cmd = "JS_BINARY__SILENT_ON_SUCCESS=1 BAZEL_BINDIR=$(BINDIR) $(execpath :stdout_stderr_bin) > $@ 2>&1",
    target_compatible_with = BASH_LAUNCHER_ONLY,
    tools = [":stdout_stderr_bin"],
)

write_file(
    name = "direct_silent_expected",
    out = "direct_silent_expected.txt",
    content = [],
)

diff_test(
    name = "direct_silent_on_success_test",
    file1 = ":direct_silent_expected.txt",
    file2 = ":direct_silent_out.txt",
)

# The same invocation without JS_BINARY__SILENT_ON_SUCCESS, so the suppression above is
# attributable to the variable rather than to the streams going missing some other way.
genrule(
    name = "direct_noisy_run",
    outs = ["direct_noisy_out.txt"],
    cmd = "BAZEL_BINDIR=$(BINDIR) $(execpath :stdout_stderr_bin) > $@ 2>&1",
    tools = [":stdout_stderr_bin"],
)

assert_contains(
    name = "direct_not_silent_stdout_test",
    actual = ":direct_noisy_out.txt",
    expected = "ON_STDOUT",
)

assert_contains(
    name = "direct_not_silent_stderr_test",
    actual = ":direct_noisy_out.txt",
    expected = "ON_STDERR",
)

# ==================================================================================================
# Case 8: with nothing but the node options the stub already applied, the hermetic launcher runs the
# program in its own node process instead of starting a second one.

js_binary(
    name = "in_process_probe_bin",
    entry_point = "in_process_probe.cjs",
)

genrule(
    name = "in_process_run",
    outs = ["in_process_out.txt"],
    cmd = "BAZEL_BINDIR=$(BINDIR) $(execpath :in_process_probe_bin) > $@",
    tools = [":in_process_probe_bin"],
)

assert_contains(
    name = "runs_in_launcher_process_test",
    actual = ":in_process_out.txt",
    expected = "IN_LAUNCHER_PROCESS=yes",
    target_compatible_with = HERMETIC_LAUNCHER_ONLY,
)

# Ungated: both launchers owe the program main-module status. A CommonJS entry point guarded by
# `require.main === module` would otherwise run nothing while still exiting 0.
assert_contains(
    name = "entry_point_is_main_module_test",
    actual = ":in_process_out.txt",
    expected = "IS_MAIN_MODULE=yes",
)

# node_options cannot be applied to a node that is already running, so a target carrying one has to
# fall back to starting node again.

js_binary(
    name = "in_process_probe_opts_bin",
    entry_point = "in_process_probe_opts.cjs",
    node_options = ["--title=probe"],
)

genrule(
    name = "in_process_opts_run",
    outs = ["in_process_opts_out.txt"],
    cmd = "BAZEL_BINDIR=$(BINDIR) $(execpath :in_process_probe_opts_bin) > $@",
    tools = [":in_process_probe_opts_bin"],
)

assert_contains(
    name = "node_options_start_a_second_node_test",
    actual = ":in_process_opts_out.txt",
    expected = "IN_LAUNCHER_PROCESS=no",
    target_compatible_with = HERMETIC_LAUNCHER_ONLY,
)

# Neither can a variable node only reads as it starts, such as NODE_OPTIONS, which a target may
# set through env rather than node_options (see examples/js_binary use case 6).

js_binary(
    name = "in_process_probe_env_bin",
    entry_point = "in_process_probe_env.cjs",
    env = {"NODE_OPTIONS": "--title=probe-env"},
)

genrule(
    name = "in_process_env_run",
    outs = ["in_process_env_out.txt"],
    cmd = "BAZEL_BINDIR=$(BINDIR) $(execpath :in_process_probe_env_bin) > $@",
    tools = [":in_process_probe_env_bin"],
)

assert_contains(
    name = "node_env_starts_a_second_node_test",
    actual = ":in_process_env_out.txt",
    expected = "IN_LAUNCHER_PROCESS=no",
    target_compatible_with = HERMETIC_LAUNCHER_ONLY,
)

# Ungated: the option has to reach node under either launcher. This is the user-visible half, and
# the reason the fall back above exists.
assert_contains(
    name = "node_options_from_env_apply_test",
    actual = ":in_process_env_out.txt",
    expected = "TITLE=probe-env",
)

# NODE_ENV is not such a variable: node reads nothing from it, so the program keeps the launcher's
# process. Worth pinning because it is by far the most common js_binary env entry, and treating it
# as a node variable would quietly cost the fast path almost everywhere.

js_binary(
    name = "in_process_probe_node_env_bin",
    entry_point = "in_process_probe_node_env.cjs",
    env = {"NODE_ENV": "production"},
)

genrule(
    name = "in_process_node_env_run",
    outs = ["in_process_node_env_out.txt"],
    cmd = "BAZEL_BINDIR=$(BINDIR) $(execpath :in_process_probe_node_env_bin) > $@",
    tools = [":in_process_probe_node_env_bin"],
)

assert_contains(
    name = "node_env_keeps_one_process_test",
    actual = ":in_process_node_env_out.txt",
    expected = "IN_LAUNCHER_PROCESS=yes",
    target_compatible_with = HERMETIC_LAUNCHER_ONLY,
)

# Ungated: exempting the variable is only sound while it still reaches the program.
assert_contains(
    name = "node_env_reaches_the_program_test",
    actual = ":in_process_node_env_out.txt",
    expected = "NODE_ENV=production",
)

# The condition is decided at analysis time and baked into the generated launcher, so it can be
# read straight out of it without running anything. The false case is pinned by the launcher
# snapshot in //js/private/test/snapshots.

filegroup(
    name = "in_process_probe_env_launcher_js",
    srcs = [":in_process_probe_env_bin"],
    output_group = "launcher_js",
    target_compatible_with = HERMETIC_LAUNCHER_ONLY,
)

assert_contains(
    name = "node_options_env_configures_startup_test",
    actual = ":in_process_probe_env_launcher_js",
    expected = "const ENV_CONFIGURES_NODE_STARTUP = true",
    target_compatible_with = HERMETIC_LAUNCHER_ONLY,
)

# A startup variable without the NODE_ prefix counts too. Nothing else covers that half of the
# list, which node documents under "Environment variables:" alongside the prefixed ones.

js_binary(
    name = "tz_env_bin",
    entry_point = "in_process_probe.cjs",
    env = {"TZ": "UTC"},
)

filegroup(
    name = "tz_env_launcher_js",
    srcs = [":tz_env_bin"],
    output_group = "launcher_js",
    target_compatible_with = HERMETIC_LAUNCHER_ONLY,
)

assert_contains(
    name = "tz_env_configures_startup_test",
    actual = ":tz_env_launcher_js",
    expected = "const ENV_CONFIGURES_NODE_STARTUP = true",
    target_compatible_with = HERMETIC_LAUNCHER_ONLY,
)

# ==================================================================================================
# Case 9: an uncaught exception is reported by node itself, with the program's own stack.
#
# Ungated: neither launcher may interpose on this. The hermetic launcher installs an
# uncaughtException handler for its own failures, and has to hand it back before running the
# program in its process, or the stack below is replaced by a one-line FATAL.

js_binary(
    name = "throw_deep_bin",
    entry_point = "throw_deep.cjs",
)

genrule(
    name = "throw_deep_run",
    outs = ["throw_deep_out.txt"],
    cmd = "BAZEL_BINDIR=$(BINDIR) $(execpath :throw_deep_bin) > $@ 2>&1 || true",
    tools = [":throw_deep_bin"],
)

assert_contains(
    name = "uncaught_exception_keeps_program_stack_test",
    actual = ":throw_deep_out.txt",
    expected = "at inner",
)
