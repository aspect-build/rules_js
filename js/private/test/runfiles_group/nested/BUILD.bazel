load("@aspect_rules_js//js:defs.bzl", "js_binary")
load("@aspect_rules_js//js/private/test/runfiles_group:fixtures.bzl", "opaque_jsinfo")
load(
    "@aspect_rules_js//js/private/test/runfiles_group:semantics.bzl",
    "p5_external_semantics_test",
)
load("@rules_runfiles_group//runfiles_group:runfiles_group_analysis_test.bzl", "runfiles_group_analysis_test")

package(default_testonly = True)

# This workspace sees aspect_rules_js as an external module. Source-backed JS
# from that module is first_party, same as a local source with the same basename.

opaque_jsinfo(
    name = "external_src",
    shared = "@aspect_rules_js//js/private/test/runfiles_group:shared.js",
)

opaque_jsinfo(
    name = "local_src",
    shared = "shared.js",
)

js_binary(
    name = "p5_bin",
    data = [
        ":external_src",
        ":local_src",
    ],
    entry_point = "main.js",
    include_npm = False,
    no_copy_to_bin = [
        "@aspect_rules_js//js/private/test/runfiles_group:shared.js",
        "shared.js",
    ],
)

runfiles_group_analysis_test(
    name = "p5_bin_contract",
    binaries = [":p5_bin"],
    check_disabled = False,
    overlapping_group_behavior = "ignore",
    max_groups = 100,
)

p5_external_semantics_test(
    name = "p5_external_semantics",
    target_under_test = ":p5_bin",
    root_a = "@aspect_rules_js//js/private/test/runfiles_group:shared.js",
    root_b = "shared.js",
)
