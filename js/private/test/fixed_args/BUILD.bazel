load("@bazel_lib//lib:testing.bzl", "assert_contains")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("//js:defs.bzl", "js_binary", "js_run_binary")

package(default_testonly = True)

js_binary(
    name = "fixed_args_bin",
    entry_point = "fixed_args.mjs",
    fixed_args = [
        "--pneumonoultramicroscopicsilicovolcanoconiosis",
    ],
)

js_run_binary(
    name = "run_fixed_args_binary",
    silent_on_success = False,
    stdout = "fixed_args_out",
    tool = ":fixed_args_bin",
)

assert_contains(
    name = "fixed_args_test",
    actual = "fixed_args_out",
    expected = "--pneumonoultramicroscopicsilicovolcanoconiosis",
)

js_binary(
    name = "args_bin",
    args = [
        "--pneumonoultramicroscopicsilicovolcanoconiosis",
    ],
    entry_point = "fixed_args.mjs",
)

js_run_binary(
    name = "run_args_binary",
    silent_on_success = False,
    stdout = "args_out",
    tool = ":args_bin",
)

assert_contains(
    name = "args_test",
    actual = "args_out",
    expected = "undefined",
)

js_binary(
    name = "locations_bin",
    data = ["test.txt"],
    entry_point = "fixed_args.mjs",
    fixed_args = [
        "$(rootpaths :test.txt)",
    ],
)

js_run_binary(
    name = "run_locations",
    silent_on_success = False,
    stdout = "locations_out",
    tool = ":locations_bin",
)

assert_contains(
    name = "locations_test",
    actual = "locations_out",
    expected = "js/private/test/fixed_args/test.txt",
)

js_binary(
    name = "locations_bin_no_expand",
    data = ["test.txt"],
    entry_point = "fixed_args.mjs",
    expand_args = False,
    fixed_args = [
        "'$(rootpaths :test.txt)'",
    ],
)

js_run_binary(
    name = "run_locations_no_expand",
    silent_on_success = False,
    stdout = "locations_out_no_expand",
    tool = ":locations_bin_no_expand",
)

assert_contains(
    name = "locations_test_no_expand",
    actual = "locations_out_no_expand",
    expected = "$(rootpaths :test.txt)",
)

# The presence of single quotes should prevent $VAR expansion from happening at run time.
js_binary(
    name = "single_quoted_var_bin",
    entry_point = "fixed_args.mjs",
    expand_args = False,
    fixed_args = [
        "'$JS_BINARY__WORKSPACE/x'",
    ],
)

js_run_binary(
    name = "run_single_quoted_var",
    silent_on_success = False,
    stdout = "single_quoted_var_out",
    tool = ":single_quoted_var_bin",
)

assert_contains(
    name = "single_quoted_var_test",
    actual = "single_quoted_var_out",
    expected = "$JS_BINARY__WORKSPACE/x",
)

# Without single quotes, the $VAR expansion does happen.
js_binary(
    name = "unquoted_var_bin",
    entry_point = "fixed_args.mjs",
    expand_args = False,
    fixed_args = [
        "$JS_BINARY__WORKSPACE/x",
    ],
)

js_run_binary(
    name = "run_unquoted_var",
    silent_on_success = False,
    stdout = "unquoted_var_out",
    tool = ":unquoted_var_bin",
)

assert_contains(
    name = "unquoted_var_test",
    actual = "unquoted_var_out",
    expected = "_main/x",
)

##############################################################################################
# Tokenization. Each fixed_arg is split at analysis time and the pieces are baked into the
# launcher quoted, so the shell expands them but does not split or glob them.

write_file(
    name = "write_a",
    out = "split_a.txt",
    content = [],
)

write_file(
    name = "write_b",
    out = "split_b.txt",
    content = [],
)

filegroup(
    name = "split_files",
    srcs = [
        "split_a.txt",
        "split_b.txt",
    ],
)

js_binary(
    name = "tokenize_bin",
    data = [":split_files"],
    entry_point = "all_args.mjs",
    fixed_args = [
        # Quoted whitespace holds an argument together; unquoted whitespace splits it.
        "\"one argument\"",
        "two arguments",
        # One fixed_arg expanding to several paths becomes several arguments.
        "$(rootpaths :split_files)",
        # A glob is passed through rather than matched against the bindir.
        "js/private/test/fixed_args/*.txt",
        # A double quote survives the quoting the launcher puts around each argument.
        "'say \"hi\"'",
    ],
)

js_run_binary(
    name = "run_tokenize",
    silent_on_success = False,
    stdout = "tokenize_out",
    tool = ":tokenize_bin",
)

[
    assert_contains(
        name = "tokenize_%s_test" % name,
        actual = "tokenize_out",
        expected = expected,
    )
    for (name, expected) in [
        ("quoted_space_is_one_arg", "[one argument]"),
        ("unquoted_space_splits_first", "[two]"),
        ("unquoted_space_splits_second", "[arguments]"),
        ("rootpaths_splits_first", "[js/private/test/fixed_args/split_a.txt]"),
        ("rootpaths_splits_second", "[js/private/test/fixed_args/split_b.txt]"),
        ("glob_is_literal", "[js/private/test/fixed_args/*.txt]"),
        ("double_quote_survives", "[say \"hi\"]"),
    ]
]
