load("@bazel_lib//lib:testing.bzl", "assert_contains")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("//js:defs.bzl", "js_binary", "js_run_binary")
load(":rejected_case.bzl", "rejected_case")
load(":shell_expansion_case.bzl", "shell_expansion_case")

package(default_testonly = True)

js_binary(
    name = "fixed_args_bin",
    entry_point = "fixed_args.mjs",
    fixed_args = [
        "--pneumonoultramicroscopicsilicovolcanoconiosis",
    ],
)

js_run_binary(
    name = "run_fixed_args_binary",
    silent_on_success = False,
    stdout = "fixed_args_out",
    tool = ":fixed_args_bin",
)

assert_contains(
    name = "fixed_args_test",
    actual = "fixed_args_out",
    expected = "--pneumonoultramicroscopicsilicovolcanoconiosis",
)

js_binary(
    name = "args_bin",
    args = [
        "--pneumonoultramicroscopicsilicovolcanoconiosis",
    ],
    entry_point = "fixed_args.mjs",
)

js_run_binary(
    name = "run_args_binary",
    silent_on_success = False,
    stdout = "args_out",
    tool = ":args_bin",
)

assert_contains(
    name = "args_test",
    actual = "args_out",
    expected = "undefined",
)

js_binary(
    name = "locations_bin",
    data = ["test.txt"],
    entry_point = "fixed_args.mjs",
    fixed_args = [
        "$(rootpaths :test.txt)",
    ],
)

js_run_binary(
    name = "run_locations",
    silent_on_success = False,
    stdout = "locations_out",
    tool = ":locations_bin",
)

assert_contains(
    name = "locations_test",
    actual = "locations_out",
    expected = "js/private/test/fixed_args/test.txt",
)

js_binary(
    name = "locations_bin_no_expand",
    data = ["test.txt"],
    entry_point = "fixed_args.mjs",
    expand_args = False,
    fixed_args = [
        "'$(rootpaths :test.txt)'",
    ],
)

js_run_binary(
    name = "run_locations_no_expand",
    silent_on_success = False,
    stdout = "locations_out_no_expand",
    tool = ":locations_bin_no_expand",
)

assert_contains(
    name = "locations_test_no_expand",
    actual = "locations_out_no_expand",
    expected = "$(rootpaths :test.txt)",
)

# The presence of single quotes should prevent $VAR expansion from happening at run time.
js_binary(
    name = "single_quoted_var_bin",
    entry_point = "fixed_args.mjs",
    expand_args = False,
    fixed_args = [
        "'$JS_BINARY__WORKSPACE/x'",
    ],
)

js_run_binary(
    name = "run_single_quoted_var",
    silent_on_success = False,
    stdout = "single_quoted_var_out",
    tool = ":single_quoted_var_bin",
)

assert_contains(
    name = "single_quoted_var_test",
    actual = "single_quoted_var_out",
    expected = "$JS_BINARY__WORKSPACE/x",
)

# Without single quotes, the $VAR expansion does happen.
js_binary(
    name = "unquoted_var_bin",
    entry_point = "fixed_args.mjs",
    expand_args = False,
    fixed_args = [
        "$JS_BINARY__WORKSPACE/x",
    ],
)

js_run_binary(
    name = "run_unquoted_var",
    silent_on_success = False,
    stdout = "unquoted_var_out",
    tool = ":unquoted_var_bin",
)

assert_contains(
    name = "unquoted_var_test",
    actual = "unquoted_var_out",
    expected = "_main/x",
)

##############################################################################################
# Tokenization. Each fixed_arg is split at analysis time and the pieces are baked into the
# launcher quoted, so the shell expands them but does not split or glob them.

write_file(
    name = "write_a",
    out = "split_a.txt",
    content = [],
)

write_file(
    name = "write_b",
    out = "split_b.txt",
    content = [],
)

filegroup(
    name = "split_files",
    srcs = [
        "split_a.txt",
        "split_b.txt",
    ],
)

js_binary(
    name = "tokenize_bin",
    data = [":split_files"],
    entry_point = "all_args.mjs",
    fixed_args = [
        # Quoted whitespace holds an argument together; unquoted whitespace splits it.
        "\"one argument\"",
        "two arguments",
        # One fixed_arg expanding to several paths becomes several arguments.
        "$(rootpaths :split_files)",
        # A glob is passed through rather than matched against the bindir.
        "js/private/test/fixed_args/*.txt",
        # A double quote survives the quoting the launcher puts around each argument.
        "'say \"hi\"'",
    ],
)

js_run_binary(
    name = "run_tokenize",
    silent_on_success = False,
    stdout = "tokenize_out",
    tool = ":tokenize_bin",
)

[
    assert_contains(
        name = "tokenize_%s_test" % name,
        actual = "tokenize_out",
        expected = expected,
    )
    for (name, expected) in [
        ("quoted_space_is_one_arg", "[one argument]"),
        ("unquoted_space_splits_first", "[two]"),
        ("unquoted_space_splits_second", "[arguments]"),
        ("rootpaths_splits_first", "[js/private/test/fixed_args/split_a.txt]"),
        ("rootpaths_splits_second", "[js/private/test/fixed_args/split_b.txt]"),
        ("glob_is_literal", "[js/private/test/fixed_args/*.txt]"),
        ("double_quote_survives", "[say \"hi\"]"),
    ]
]

# ==================================================================================================
# Shell expansion of fixed_args.
#
# js_binary.bzl splits each fixed_arg into arguments at analysis time. The bash launcher gets
# one double-quoted word per argument and the hermetic launcher gets the same tokens without a
# shell, so a case only needs bash_only or hermetic_only where the expansion that is left over
# differs. A construct that could not survive the split is a build error rather than a silent
# mangling; those cases are rejected_case rather than shell_expansion_case.
#
# --------------------------------------------------------------------------------------------
# Word splitting and quote removal. Where one argument ends and the next begins is decided at
# analysis time.

shell_expansion_case(
    name = "plain",
    fixed_args = ["--flag"],
    want_argv = ["--flag"],
)

shell_expansion_case(
    name = "space_splits_one_entry",
    fixed_args = ["one two"],
    want_argv = [
        "one",
        "two",
    ],
)

shell_expansion_case(
    name = "two_entries_are_indistinguishable",
    fixed_args = [
        "one",
        "two",
    ],
    want_argv = [
        "one",
        "two",
    ],
)

shell_expansion_case(
    name = "whitespace_runs_collapse",
    fixed_args = ["a  b"],
    want_argv = [
        "a",
        "b",
    ],
)

shell_expansion_case(
    name = "newline_splits",
    fixed_args = ["a\nb"],
    want_argv = [
        "a",
        "b",
    ],
)

# An empty argument cannot be passed at all.
shell_expansion_case(
    name = "empty_entry_disappears",
    fixed_args = [""],
    want_argv = [],
)

shell_expansion_case(
    name = "empty_entry_among_others_disappears",
    fixed_args = [
        "",
        "b",
    ],
    want_argv = ["b"],
)

shell_expansion_case(
    name = "single_quotes_group",
    fixed_args = ["'one two'"],
    want_argv = ["one two"],
)

shell_expansion_case(
    name = "double_quotes_group",
    fixed_args = ["\"one two\""],
    want_argv = ["one two"],
)

shell_expansion_case(
    name = "quotes_removed_mid_word",
    fixed_args = ["a\"b\"c"],
    want_argv = ["abc"],
)

shell_expansion_case(
    name = "quoted_flag_value_keeps_space",
    fixed_args = ["--flag='x y'"],
    want_argv = ["--flag=x y"],
)

shell_expansion_case(
    name = "ordinary_punctuation_survives",
    fixed_args = [
        "a=b",
        "a!b",
        "a@b",
        "a%b",
        "a#b",
    ],
    want_argv = [
        "a=b",
        "a!b",
        "a@b",
        "a%b",
        "a#b",
    ],
)

# --------------------------------------------------------------------------------------------
# Backslashes are never interpreted.

shell_expansion_case(
    name = "backslash_before_space_is_literal",
    fixed_args = ["one\\ two"],
    want_argv = [
        "one\\",
        "two",
    ],
)

shell_expansion_case(
    name = "backslash_before_letter_is_kept",
    fixed_args = ["a\\b"],
    want_argv = ["a\\b"],
)

shell_expansion_case(
    name = "windows_path_survives",
    fixed_args = ["C:\\Users\\foo"],
    want_argv = ["C:\\Users\\foo"],
)

shell_expansion_case(
    name = "backslash_before_glob_is_literal",
    fixed_args = ["\\*.txt"],
    want_argv = ["\\*.txt"],
)

# ANSI-C quoting is rejected.
rejected_case(
    name = "ansi_c_quoting",
    fixed_args = ["$'a\\tb'"],
    want_error = "$' quoting is not supported in a fixed_arg",
)

# --------------------------------------------------------------------------------------------
# Brace expansion has no effect.

shell_expansion_case(
    name = "brace_list",
    fixed_args = ["{a,b}"],
    want_argv = ["{a,b}"],
)

shell_expansion_case(
    name = "brace_range",
    fixed_args = ["pre{1..3}"],
    want_argv = ["pre{1..3}"],
)

shell_expansion_case(
    name = "brace_without_comma_is_literal",
    fixed_args = ["{a}"],
    want_argv = ["{a}"],
)

# --------------------------------------------------------------------------------------------
# Parameter expansion. The launcher exports `env` before it builds the argument array, so a
# fixed_arg can read the target's own environment.

shell_expansion_case(
    name = "braced_var",
    fixed_args = ["${JS_BINARY__WORKSPACE}"],
    want_argv = ["_main"],
)

shell_expansion_case(
    name = "default_for_unset_var",
    bash_only = True,
    fixed_args = ["${JS_BINARY_FIXED_ARGS_UNSET:-fallback}"],
    want_argv = ["fallback"],
)

# The full set of substring operators is available.
shell_expansion_case(
    name = "substring_operator",
    bash_only = True,
    fixed_args = ["${JS_BINARY__WORKSPACE#_}"],
    want_argv = ["main"],
)

# Splitting happens at analysis time, so an expanded value is never split again.
shell_expansion_case(
    name = "env_value_is_not_word_split",
    env = {"CASE_SPACEY": "a b"},
    fixed_args = ["$CASE_SPACEY"],
    want_argv = ["a b"],
)

# Whitespace inside ${...} is rejected.
rejected_case(
    name = "param_expansion_with_space",
    fixed_args = ["${JS_BINARY__WORKSPACE:-a b}"],
    want_error = "whitespace inside ${...} would split a fixed_arg",
)

# env values are json.encode()d into the launcher, so an apostrophe in an env value is
# harmless. So is one written directly in fixed_args; see apostrophe_is_literal below.
shell_expansion_case(
    name = "env_value_with_apostrophe_is_safe",
    env = {"CASE_QUOTEY": "it's"},
    fixed_args = ["$CASE_QUOTEY"],
    want_argv = ["it's"],
)

# A word only has to look like a node option *after* expansion to be intercepted by the
# launcher's own flag scan, in which case the program never sees it.
shell_expansion_case(
    name = "expanded_node_options_is_intercepted",
    env = {"CASE_OPT": "--node_options=--no-warnings"},
    fixed_args = ["$CASE_OPT"],
    want_argv = [],
)

# --------------------------------------------------------------------------------------------
# Tilde expansion is not supported. HOME is pinned on the target so a
# regression here would not read as the developer's own home directory.

shell_expansion_case(
    name = "tilde_alone",
    env = {"HOME": "/js_binary_test_home"},
    fixed_args = ["~"],
    want_argv = ["~"],
)

shell_expansion_case(
    name = "tilde_with_path",
    env = {"HOME": "/js_binary_test_home"},
    fixed_args = ["~/sub"],
    want_argv = ["~/sub"],
)

# --------------------------------------------------------------------------------------------
# Command substitution and arithmetic. Under the bash launcher a fixed_arg can still run an
# arbitrary program at launch, but only where the whole substitution stays inside one argument:
# tokenizing would otherwise cut it in half and bash would reparse the pieces into a different
# command. The hermetic launcher expands only $NAME and ${NAME}, so these are bash_only.

rejected_case(
    name = "command_substitution",
    fixed_args = ["$(echo hi)"],
    want_error = "whitespace inside $(...) would split a fixed_arg",
)

rejected_case(
    name = "backtick_substitution",
    fixed_args = ["`echo tick`"],
    want_error = "whitespace inside `...` would split a fixed_arg",
)

# Double quotes are the way to keep one: the space is no longer a token boundary.
shell_expansion_case(
    name = "double_quoted_command_substitution",
    bash_only = True,
    fixed_args = ["\"$(echo hi)\""],
    want_argv = ["hi"],
)

# The hermetic launcher has no shell to run it in, so the text arrives as itself.
shell_expansion_case(
    name = "double_quoted_command_substitution_is_literal",
    fixed_args = ["\"$(echo hi)\""],
    hermetic_only = True,
    want_argv = ["$(echo hi)"],
)

# Single quotes keep it from running at all, as they always did.
shell_expansion_case(
    name = "single_quoted_command_substitution",
    fixed_args = ["'$(echo hi)'"],
    want_argv = ["$(echo hi)"],
)

shell_expansion_case(
    name = "arithmetic_expansion",
    bash_only = True,
    fixed_args = ["$((1+2))"],
    want_argv = ["3"],
)

# --------------------------------------------------------------------------------------------
# Globbing is not supported. The srcs put real matches at the path the pattern
# names, so a regression would show up as an expansion rather than as a no-op.

shell_expansion_case(
    name = "glob_is_literal",
    srcs = [
        "globdir/alpha.txt",
        "globdir/beta.txt",
    ],
    fixed_args = ["js/private/test/fixed_args/globdir/*.txt"],
    want_argv = ["js/private/test/fixed_args/globdir/*.txt"],
)

shell_expansion_case(
    name = "glob_single_character_is_literal",
    srcs = [
        "globdir/alpha.txt",
        "globdir/beta.txt",
    ],
    fixed_args = ["js/private/test/fixed_args/globdir/alph?.txt"],
    want_argv = ["js/private/test/fixed_args/globdir/alph?.txt"],
)

shell_expansion_case(
    name = "glob_without_match_is_literal",
    srcs = [
        "globdir/alpha.txt",
        "globdir/beta.txt",
    ],
    fixed_args = ["js/private/test/fixed_args/globdir/*.nomatch"],
    want_argv = ["js/private/test/fixed_args/globdir/*.nomatch"],
)

shell_expansion_case(
    name = "quoted_glob_is_literal",
    srcs = [
        "globdir/alpha.txt",
        "globdir/beta.txt",
    ],
    fixed_args = ["'js/private/test/fixed_args/globdir/*.txt'"],
    want_argv = ["js/private/test/fixed_args/globdir/*.txt"],
)

# --------------------------------------------------------------------------------------------
# Both layers at once: Bazel make-variable expansion at analysis time, then the shell at run
# time. These cases set expand_args = True.

filegroup(
    name = "globdir_files",
    srcs = [
        "globdir/alpha.txt",
        "globdir/beta.txt",
    ],
)

shell_expansion_case(
    name = "dollar_dollar_reaches_the_shell",
    expand_args = True,
    fixed_args = ["$$JS_BINARY__WORKSPACE"],
    want_argv = ["_main"],
)

shell_expansion_case(
    name = "rootpaths_plural_splits",
    data = [":globdir_files"],
    expand_args = True,
    fixed_args = ["$(rootpaths :globdir_files)"],
    want_argv = [
        "js/private/test/fixed_args/globdir/alpha.txt",
        "js/private/test/fixed_args/globdir/beta.txt",
    ],
)

# --------------------------------------------------------------------------------------------
# Shell metacharacters, which used to be spliced into the launcher as source text and so could
# stop it from parsing. Each is now one double-quoted word and reaches the program intact.

shell_expansion_case(
    name = "hash_is_literal",
    fixed_args = ["#comment"],
    want_argv = ["#comment"],
)

shell_expansion_case(
    name = "semicolon_is_literal",
    fixed_args = ["a;b"],
    want_argv = ["a;b"],
)

shell_expansion_case(
    name = "pipe_is_literal",
    fixed_args = ["a|b"],
    want_argv = ["a|b"],
)

shell_expansion_case(
    name = "redirect_is_literal",
    fixed_args = ["a>b"],
    want_argv = ["a>b"],
)

shell_expansion_case(
    name = "paren_is_literal",
    fixed_args = ["a(b"],
    want_argv = ["a(b"],
)

# --------------------------------------------------------------------------------------------
# A quote that is never closed has no partner to pair with, so it is just a character. It
# used to reach bash as unbalanced source text and stop the launcher from parsing.

shell_expansion_case(
    name = "apostrophe_is_literal",
    fixed_args = ["it's"],
    want_argv = ["it's"],
)

shell_expansion_case(
    name = "double_quote_is_literal",
    fixed_args = ["a\"b"],
    want_argv = ["a\"b"],
)

# --------------------------------------------------------------------------------------------
# Values that are refused at analysis time.

# A lone backtick is the exception: passing it through would need it escaped, and escaping
# backticks would stop `...` substitution from working at all.
rejected_case(
    name = "backtick_unterminated",
    fixed_args = ["a`b"],
    want_error = "unterminated `...` in a fixed_arg",
)

# Under `set -o errexit` a failing command substitution used to become the launcher's own exit
# code. It holds a space, so it never reaches the launcher now.
rejected_case(
    name = "failing_command_substitution",
    fixed_args = ["$(exit 7)"],
    want_error = "whitespace inside $(...) would split a fixed_arg",
)

# --------------------------------------------------------------------------------------------
# Values that still stop the launcher from running at all.
#
# This case exits 0 on macOS. It ships an old version of bash (3.2), which runs the launcher's
# EXIT trap with `$?` set to 0.

# The launcher runs under `set -o nounset`, so naming a variable nothing set is fatal.
shell_expansion_case(
    name = "unset_var_breaks_launcher",
    bash_only = True,
    fixed_args = ["$JS_BINARY_FIXED_ARGS_UNSET"],
    macos_want_exit_code = "0",
    want_exit_code = "1",
    want_stderr = "unbound variable",
)

# The hermetic launcher behaves the same way except that it returns an exit code of 1 on macOS.
shell_expansion_case(
    name = "unset_var_is_fatal",
    fixed_args = ["$JS_BINARY_FIXED_ARGS_UNSET"],
    hermetic_only = True,
    want_exit_code = "1",
    want_stderr = "unbound variable",
)
